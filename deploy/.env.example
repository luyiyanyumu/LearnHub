# 复制成 .env 后按需修改： cp .env.example .env
# 这个文件只给 docker compose 读（端口、数据库口令、API key），会被 .gitignore 忽略。

# ===== AI（可选：不填也能跑，只是智能体/wiki/翻译不可用）=====
# 也可以启动后到界面「设置 → 外观与 AI」里填，数据库里的配置优先
DEEPSEEK_API_KEY=

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=learn_hub
# 宿主机端口：这台机器上如果已经有 MySQL 占着 3307，改这里
MYSQL_HOST_PORT=3307

# ===== 基础镜像来源 =====
# 国内直连 Docker Hub（auth.docker.io / registry-1.docker.io）经常超时，所以默认走加速源。
# 能直连的话把它设成空值即可（Dockerfile 里的 FROM 会退回官方名字）：
#   DOCKER_REGISTRY=
DOCKER_REGISTRY=docker.1ms.run

# ===== 对外端口 =====
# 网页入口（nginx）
WEB_HOST_PORT=8888
# 后端直连端口（MCP server 默认连 localhost:18080，所以这里最好保持一致）
BACKEND_HOST_PORT=18080

# ===== 容器名（改这里可以让新栈与机器上的旧部署并存）=====
# 如果这台机器上已经有 learn-hub-mysql 之类的旧容器（例如之前用 docker run 起的），
# compose 会因为"名字被占用"直接报错。把下面三个改成别的名字即可并存（数据各自独立）。
# MYSQL_CONTAINER_NAME=learn-hub-mysql
# BACKEND_CONTAINER_NAME=learn-hub-backend
# FRONTEND_CONTAINER_NAME=learn-hub-frontend

# ===== JVM（可选）=====
# 默认按容器内存上限的 75% 设堆；想固定就写 -Xmx1g 这种
# JAVA_OPTS=-XX:MaxRAMPercentage=75
