# The npm launcher creates this file in the instance home (~/.learnhub by default).
# Start reuses the saved application version. Update changes LEARNHUB_VERSION only.
LEARNHUB_VERSION=0.1.0
LEARNHUB_IMAGE_PREFIX=ghcr.io/luyiyanyumu/learnhub
LEARNHUB_PROJECT_NAME=learn-hub

# Keep the database image unchanged during application updates.
# For adoption, use the existing container's exact image rather than this fresh-install default.
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=learn_hub
# Replace before use; the launcher generates a random password for a fresh instance.
MYSQL_ROOT_PASSWORD=

# Existing LearnHub Compose volumes use these names. Override when adopting other volumes.
MYSQL_VOLUME_NAME=learn-hub_mysql-data
UPLOADS_VOLUME_NAME=learn-hub_uploads
OLLAMA_VOLUME_NAME=learn-hub_ollama-models
SKILLS_VOLUME_NAME=learn-hub_skills-data
# Optional old .env container names remain supported.
# MYSQL_CONTAINER_NAME=learn-hub-mysql
# BACKEND_CONTAINER_NAME=learn-hub-backend
# FRONTEND_CONTAINER_NAME=learn-hub-frontend
# OLLAMA_CONTAINER_NAME=learn-hub-ollama

# Relative to the instance compose file, not the current terminal directory.
CONFIG_DIR=./config
BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8888
BACKEND_HOST_PORT=18080
MYSQL_HOST_PORT=3307

# Optional AI configuration. App settings stored in MySQL take priority.
DEEPSEEK_API_KEY=
KB_EMBED_BASE_URL=http://ollama:11434
KB_EMBED_MODEL=bge-m3
# Optional image; application updates do not pull or upgrade Ollama.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_HOST_PORT=11434
JAVA_OPTS=-XX:MaxRAMPercentage=75
