<Window x:Class="LearnHub.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LearnHub · 服务管理器" Background="#F7F8FA"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="32">
      <TextBlock Text="LearnHub" Foreground="#0B7F72" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock x:Name="LoadingText" Text="正在打开服务管理器…" Foreground="#5A6B67" FontSize="14" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" />
      <Button x:Name="RuntimeLink" Content="查看 WebView2 Runtime 安装说明" Visibility="Collapsed" Padding="14,8" Margin="0,20,0,0" Click="RuntimeLink_Click" />
    </StackPanel>
    <web:WebView2 x:Name="Browser" Visibility="Collapsed" />
  </Grid>
</Window>
